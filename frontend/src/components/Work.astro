---
import { entries } from "../data/work";
import WorkIndex from "./WorkIndex.astro";

const years = new Date().getFullYear() - 2021;
---

<section id="work" class="section ruled" aria-labelledby="work-title">
  <header>
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-rule pb-4">
      <p class="micro text-ink-3"><span class="text-ink-4">01</span> — Work</p>
      <p class="micro micro-xs tnum text-ink-4">{entries.length} entries</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-x-16 gap-y-6 lg:grid-cols-12">
      <h2 id="work-title" class="t-h2 text-ink lg:col-span-7">
        Everything I&rsquo;ve built, in one index.
      </h2>
      <p class="t-body lg:col-span-5">
        {years} years of products and retired experiments. Open any row for the architecture, the
        numbers, and what was deliberately left out.
      </p>
    </div>
  </header>

  <WorkIndex class="mt-12" />
</section>
