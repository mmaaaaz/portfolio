---
import { currentFocus, practice } from "../data/work";

const years = new Date().getFullYear() - 2021;
---

<section id="practice" class="section ruled" aria-labelledby="practice-title">
  <header>
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-rule pb-4">
      <p class="micro text-ink-3"><span class="text-ink-4">03</span> — Practice</p>
      <p class="micro micro-xs text-ink-4">How the work gets made</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-x-16 gap-y-6 lg:grid-cols-12">
      <h2 id="practice-title" class="t-h2 text-ink lg:col-span-7">
        Three rules that decide most of the calls.
      </h2>
      <p class="t-body lg:col-span-5">
        {years} years of freelance work across e-commerce, marketing sites and AI tooling — with most
        of the learning coming from the parts that went wrong first.
      </p>
    </div>
  </header>

  <ol class="mt-14 grid gap-x-16 gap-y-12 lg:grid-cols-3" data-reveal>
    {
      practice.map((rule) => (
        <li class="border-t border-rule-strong pt-6">
          <p class="micro tnum text-ember">{rule.n}</p>
          <h3 class="t-h3 mt-5 text-ink">{rule.title}</h3>
          <p class="t-body mt-4">{rule.body}</p>
        </li>
      ))
    }
  </ol>

  <div class="mt-20 grid grid-cols-1 gap-x-16 gap-y-6 border-t border-rule pt-8 lg:grid-cols-12" data-reveal>
    <p class="micro text-ink-4 lg:col-span-3">Current focus</p>
    <ul class="grid gap-x-12 gap-y-5 sm:grid-cols-2 lg:col-span-9">
      {
        currentFocus.map((focus) => (
          <li class="flex gap-3 text-[0.9375rem] leading-relaxed text-ink-2">
            <span class="mt-[0.55em] h-1 w-1 shrink-0 bg-ember" aria-hidden="true" />
            <span>{focus}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
