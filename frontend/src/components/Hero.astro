---
// Modern 2025 hero with expressive typography
const profile = (await import("../data/profile.json")).default;
---

<section
  class="relative flex items-center px-4 sm:px-6 lg:px-8 py-20 sm:py-32 lg:py-40 gpu-accelerated overflow-hidden"
>
  <!-- Subtle grid background -->
  <div
    class="absolute inset-0 opacity-[0.015]"
    style="background-image: linear-gradient(var(--color-text-primary) 1px, transparent 1px), linear-gradient(90deg, var(--color-text-primary) 1px, transparent 1px); background-size: 40px 40px;"
  >
  </div>

  <div class="container mx-auto max-w-6xl relative z-10">
    <!-- Asymmetric layout with offset border -->
    <div class="lg:ml-12">
      <div class="border-l-[3px] border-zinc-50 pl-6 sm:pl-8 lg:pl-12 space-y-8 sm:space-y-10 animate-fade-in mx-1">
        <!-- Expressive name treatment -->
        <div class="space-y-6">
          <div class="inline-block relative">
            <h1
              class="text-display text-[clamp(4rem,12vw,7.5rem)] font-extrabold text-zinc-50 uppercase leading-none tracking-tight"
            >
              mz<span class="text-zinc-600">__</span>
            </h1>
          </div>

          <p
            class="text-lg sm:text-xl lg:text-2xl text-zinc-300 font-medium max-w-xl leading-snug tracking-tight break-words"
          >
            {profile.bio}
          </p>
        </div>

        <!-- Compact meta info -->
        <div class="flex flex-wrap items-center gap-6 text-sm text-zinc-400 font-mono tracking-wide">
          {
            profile.location && (
              <span class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-zinc-500 animate-pulse" />
                {profile.location}
              </span>
            )
          }
          <span class="flex items-center gap-2 group cursor-none">
            <span
              class="w-1.5 h-1.5 bg-green-500 group-hover:scale-150 transition-transform shadow-[0_0_10px_rgba(34,197,94,0.5)]"
            ></span>
            Available for work
          </span>
        </div>

        <!-- Modern link grid -->
        <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-3 sm:gap-4 pt-8 border-t border-zinc-800/60">
          <a
            href={profile.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group border border-zinc-800/80 bg-zinc-900/30 hover:border-zinc-400 hover:bg-zinc-800/50 px-5 py-3.5 text-mono text-xs uppercase tracking-widest text-zinc-400 hover:text-zinc-50 transition-all duration-300 flex items-center justify-between gap-3"
          >
            <span>GitHub</span>
            <span
              class="opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300"
              >→</span
            >
          </a>

          <a
            href="https://linkedin.com/in/mmaaaaz"
            target="_blank"
            rel="noopener noreferrer"
            class="group border border-zinc-800/80 bg-zinc-900/30 hover:border-zinc-400 hover:bg-zinc-800/50 px-5 py-3.5 text-mono text-xs uppercase tracking-widest text-zinc-400 hover:text-zinc-50 transition-all duration-300 flex items-center justify-between gap-3"
          >
            <span>LinkedIn</span>
            <span
              class="opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300"
              >→</span
            >
          </a>

          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="group border border-zinc-800/80 bg-zinc-900/30 hover:border-zinc-400 hover:bg-zinc-800/50 px-5 py-3.5 text-mono text-xs uppercase tracking-widest text-zinc-400 hover:text-zinc-50 transition-all duration-300 flex items-center justify-between gap-3"
          >
            <span>Resume</span>
            <span
              class="opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300"
              >→</span
            >
          </a>

          <a
            href={`mailto:${profile.email || "contact@" + profile.website}`}
            class="group sm:col-span-3 border border-zinc-50 bg-zinc-50 hover:bg-transparent text-zinc-950 hover:text-zinc-50 px-6 py-3.5 text-mono text-xs uppercase tracking-widest transition-all duration-300 flex items-center justify-center gap-3 font-bold shadow-[4px_4px_0px_#27272a] hover:shadow-[0px_0px_0px_transparent] hover:translate-x-[4px] hover:translate-y-[4px]"
          >
            <span>Get in Touch</span>
            <span class="group-hover:rotate-45 transition-transform duration-300">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
