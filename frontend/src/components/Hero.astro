---
// Modern 2025 hero with expressive typography
const profile = (await import("../data/profile.json")).default;
---

<section
  class="relative flex items-center px-4 sm:px-6 lg:px-8 py-20 sm:py-32 lg:py-40 gpu-accelerated overflow-hidden"
>
  <!-- Subtle grid background -->
  <div
    class="absolute inset-0 opacity-[0.02]"
    style="background-image: linear-gradient(#ffffff 1px, transparent 1px), linear-gradient(90deg, #ffffff 1px, transparent 1px); background-size: 50px 50px;"
  >
  </div>

  <div class="container mx-auto max-w-6xl relative z-10">
    <!-- Asymmetric layout with offset border -->
    <div class="lg:ml-12">
      <div class="border-l-[3px] border-white pl-6 sm:pl-8 lg:pl-12 space-y-8 sm:space-y-10 animate-fade-in">
        <!-- Expressive name treatment -->
        <div class="space-y-6">
          <div class="inline-block">
            <h1
              class="text-display text-[clamp(3.5rem,12vw,7rem)] font-black text-white uppercase leading-none tracking-tighter"
            >
              mz<span class="text-neutral-600">__</span>
            </h1>
          </div>

          <p class="text-lg sm:text-xl lg:text-2xl text-neutral-200 font-medium max-w-xl leading-snug">
            {profile.bio}
          </p>
        </div>

        <!-- Compact meta info -->
        <div class="flex flex-wrap items-center gap-6 text-sm text-neutral-500 font-mono">
          {
            profile.location && (
              <span class="flex items-center gap-2">
                <span class="w-2 h-2 bg-neutral-500 rounded-full animate-pulse" />
                {profile.location}
              </span>
            )
          }
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 bg-white"></span>
            Available for work
          </span>
        </div>

        <!-- Modern link grid -->
        <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-3 sm:gap-4 pt-6 border-t border-neutral-900">
          <a
            href={profile.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group border border-neutral-800 hover:border-white px-5 py-3 text-mono text-xs uppercase tracking-wider text-neutral-400 hover:text-white transition-all flex items-center justify-between gap-2"
          >
            <span>GitHub</span>
            <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
          </a>

          <a
            href="https://linkedin.com/in/mmaaaaz"
            target="_blank"
            rel="noopener noreferrer"
            class="group border border-neutral-800 hover:border-white px-5 py-3 text-mono text-xs uppercase tracking-wider text-neutral-400 hover:text-white transition-all flex items-center justify-between gap-2"
          >
            <span>LinkedIn</span>
            <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
          </a>

          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="group border border-neutral-800 hover:border-white px-5 py-3 text-mono text-xs uppercase tracking-wider text-neutral-400 hover:text-white transition-all flex items-center justify-between gap-2"
          >
            <span>Resume</span>
            <span class="opacity-0 group-hover:opacity-100 transition-opacity">→</span>
          </a>

          <a
            href={`mailto:${profile.email || "contact@" + profile.website}`}
            class="group sm:col-span-3 border border-white bg-white hover:bg-black text-black hover:text-white px-5 py-3 text-mono text-xs uppercase tracking-wider transition-all flex items-center justify-center gap-2 font-bold"
          >
            <span>Get in Touch</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
