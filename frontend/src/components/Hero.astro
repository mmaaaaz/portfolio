---
import profile from "../data/profile.json";
import EmailLink from "./EmailLink.astro";

/* A person read as a specimen record — not a KPI strip. */
const spec = [
  { k: "Status", v: "Open to work", lead: true },
  { k: "Practice", v: "Interface · Systems · AI · Commerce" },
  { k: "Open to", v: "Roles · Freelance · Collaboration" },
  { k: "Based in", v: `${profile.location} · UTC+5` },
];

const elsewhere = [
  { label: "GitHub", href: profile.githubUrl },
  { label: "LinkedIn", href: "https://linkedin.com/in/mmaaaaz" },
  { label: "Résumé", href: "/resume.pdf" },
];
---

<section class="hero ruled" aria-labelledby="hero-title">
  <div class="hero-intro" data-reveal>
    <p class="micro text-ink-3">Full-stack engineer — Karachi, PK</p>

    <h1 id="hero-title" class="t-display mt-8 text-ink">
      I build web products<br />end to end.
    </h1>

    <p class="t-lead mt-7 max-w-[46ch]">
      Interface, system, and the AI inside — from first sketch to production.
    </p>
  </div>

  <dl class="hero-spec spec stagger-2" data-reveal>
    {
      spec.map((row) => (
        <div class="spec__row">
          <dt class="spec__k micro micro-xs">{row.k}</dt>
          <dd class:list={["spec__v", row.lead && "spec__v--lead"]}>
            {row.lead && <span class="status-dot mr-2" aria-hidden="true" />}
            {row.v}
          </dd>
        </div>
      ))
    }
  </dl>

  <div class="hero-rail stagger-3" data-reveal>
    <div
      class="flex flex-col gap-5 border-t border-rule-strong pt-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex flex-wrap items-baseline gap-x-7 gap-y-3">
        <EmailLink
          class="link-sweep link-sweep--ember text-[0.9375rem] font-medium tracking-[-0.02em] text-ink"
        >
          Email me
        </EmailLink>
        {
          elsewhere.map((link) => (
            <a
              class="link-sweep micro micro-xs text-ink-4 transition-colors hover:text-ink"
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
              data-cursor="OPEN"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <a
        class="group micro micro-xs inline-flex shrink-0 items-center gap-2 text-ink-3 transition-colors hover:text-ink"
        href="#work"
        data-cursor="SCROLL"
      >
        Selected work
        <span class="transition-transform duration-500 group-hover:translate-y-1" aria-hidden="true"
          >↓</span
        >
      </a>
    </div>
  </div>
</section>
