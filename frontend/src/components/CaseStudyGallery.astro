---
interface Props {
  images: string[];
  title: string;
}

const { images, title } = Astro.props;
const count = images?.length ?? 0;
const span = count === 1 ? "sm:col-span-2" : "";
---

{
  count > 0 && (
    <section class="border-t border-rule py-14" aria-label="Project evidence">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="micro text-ink-4">Evidence</h2>
        <p class="micro micro-xs tnum text-ink-4">
          {count} {count === 1 ? "image" : "images"}
        </p>
      </div>
      <div class="mt-6 grid gap-px border border-rule bg-rule sm:grid-cols-2">
        {images.map((image, index) => (
          <figure class:list={["bg-paper-2", count === 1 && span]}>
            <img
              src={image}
              alt={`${title} — view ${index + 1}`}
              class="aspect-[4/3] w-full object-cover"
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </section>
  )
}
