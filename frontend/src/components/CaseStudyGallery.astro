---
interface Props {
  images: string[];
  title: string;
}

const { images, title } = Astro.props;

// Handle different gallery layouts based on image count
const imageCount = images?.length || 0;
const layoutClass =
  imageCount === 1
    ? "grid-cols-1"
    : imageCount === 2
      ? "grid-cols-1 sm:grid-cols-2"
      : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3";
---

{
  imageCount > 0 ? (
    <section class="mb-12 sm:mb-16">
      <h2 class="text-mono text-xs uppercase tracking-wider text-zinc-500 mb-6 font-bold">Gallery</h2>

      <div class={`grid ${layoutClass} gap-4`}>
        {images.map((image, index) => (
          <figure
            class={`relative overflow-hidden bg-zinc-950 border border-zinc-800 group ${
              imageCount === 1
                ? "aspect-video"
                : imageCount === 2
                  ? "aspect-[4/3]"
                  : index === 0 && imageCount > 3
                    ? "sm:col-span-2 sm:row-span-2 aspect-video"
                    : "aspect-square"
            }`}
          >
            <img
              src={image}
              alt={`${title || "Case study"} - ${title?.split(" ")[0] || "Screenshot"} view ${index + 1}`}
              onerror="this.src='data:image/svg+xml,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 16 16\'%3E%3Crect fill=\'%23404040\' width=\'16\' height=\'16\'/%3E%3Ctext x=\'50%25\' y=\'50%25\' text-anchor=\'middle\' dominant-baseline=\'middle\' font-size=\'2\' fill=\'%23aaa\'%3EImage failed to load%3C/text%3E%3C/svg%3E'; this.classList.add('opacity-50');"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading={index === 0 ? "eager" : "lazy"}
            />
            <div class="absolute inset-0 bg-zinc-950/0 group-hover:bg-zinc-950/20 transition-colors pointer-events-none" />
          </figure>
        ))}
      </div>
    </section>
  ) : (
    <div class="text-zinc-500 text-sm italic mb-12 border border-zinc-800 p-8 text-center bg-zinc-950/50">
      No case study images available
    </div>
  )
}
