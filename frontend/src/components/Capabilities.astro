---
import { capabilities } from "../data/work";

const learning = "Formal verification, Rust, and the parts of distributed systems that break at 3am.";
---

<section id="capabilities" class="section ruled" aria-labelledby="capabilities-title">
  <header>
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-rule pb-4">
      <p class="micro text-ink-3"><span class="text-ink-4">02</span> — Capabilities</p>
      <p class="micro micro-xs text-ink-4">An inventory, not a buzzword list</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-x-16 gap-y-6 lg:grid-cols-12">
      <h2 id="capabilities-title" class="t-h2 text-ink lg:col-span-7">
        The tools are the least interesting part. Here is what they are.
      </h2>
      <p class="t-body lg:col-span-5">
        Everything listed has shipped in something real, or is being learned in public. No
        proficiency bars, no percentages.
      </p>
    </div>
  </header>

  <div class="mt-14" data-reveal>
    {
      capabilities.map((group) => (
        <div class="cap-row">
          <p class="cap-row__label micro">{group.label}</p>
          <p class="cap-row__items">
            {group.items.map((item, index) => (
              <span>
                {item}
                {index < group.items.length - 1 && (
                  <span class="cap-sep" aria-hidden="true">
                    ·
                  </span>
                )}
              </span>
            ))}
          </p>
        </div>
      ))
    }
  </div>

  <div
    class="mt-12 grid grid-cols-1 gap-x-16 gap-y-4 border-t border-rule pt-6 lg:grid-cols-12"
    data-reveal
  >
    <p class="micro text-ember lg:col-span-3">Currently learning</p>
    <p class="cap-row__items lg:col-span-9">{learning}</p>
  </div>
</section>
