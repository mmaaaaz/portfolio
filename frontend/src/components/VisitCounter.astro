---
// Visit counter component with futuristic loading animation
---

<div class="visit-counter fixed bottom-6 right-6 z-40">
    <div class="border border-neutral-800 bg-black/90 backdrop-blur-sm px-4 py-3 font-mono text-xs">
        <div class="flex items-center gap-3 text-neutral-500 uppercase tracking-wider">
            <span class="w-2 h-2 bg-neutral-600 animate-pulse"></span>
            <span id="visit-count" class="text-neutral-400 loading">
                <span class="alien-text" data-final="Loading..."></span>
            </span>
        </div>
    </div>
</div>

<script>
    // Alien character set for loading animation
    const alienChars = "▓▒░█▄▀■□▪▫◘◙○●►◄↕‼¶§▬↨↑↓→←∟↔▲▼";

    // Scramble text effect - super fast
    function scrambleText(element: HTMLElement, finalText: string, duration: number = 350) {
        const startTime = Date.now();

        const animate = () => {
            const elapsed = Date.now() - startTime;
            const progress = Math.min(elapsed / duration, 1);

            // Calculate how many characters should be revealed
            const revealCount = Math.floor(progress * finalText.length);

            let output = "";
            for (let i = 0; i < finalText.length; i++) {
                if (i < revealCount) {
                    output += finalText[i];
                } else {
                    // Random alien character
                    output += alienChars[Math.floor(Math.random() * alienChars.length)];
                }
            }

            element.textContent = output;

            if (progress < 1) {
                requestAnimationFrame(animate);
            } else {
                element.textContent = finalText;
            }
        };

        animate();
    }

    // Fetch visit count - optimized with timeout
    async function updateVisitCount() {
        const countElement = document.getElementById("visit-count");
        const alienText = countElement?.querySelector(".alien-text") as HTMLElement;

        if (!alienText) return;

        // Faster initial scramble animation
        let scrambleFrame = 0;
        const initialScramble = setInterval(() => {
            let scrambled = "";
            for (let i = 0; i < 10; i++) {
                scrambled += alienChars[Math.floor(Math.random() * alienChars.length)];
            }
            alienText.textContent = scrambled;
            scrambleFrame++;

            // Stop after 5 frames (500ms max)
            if (scrambleFrame > 5) {
                clearInterval(initialScramble);
                alienText.textContent = "▓░...░▓";
            }
        }, 100);

        try {
            // Use environment variable for API URL, fallback to deployed URL
            const apiUrl = import.meta.env.PUBLIC_API_URL || "https://portfolio-api.devmaaaaz.workers.dev";

            // Add timeout to prevent hanging
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 5000); // 5 second timeout

            const response = await fetch(apiUrl, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                signal: controller.signal,
            });

            clearTimeout(timeoutId);
            clearInterval(initialScramble);

            if (!response.ok) {
                throw new Error("Failed to fetch visit count");
            }

            const data = await response.json();

            if (data.success && countElement) {
                // Format number with commas
                const formattedViews = data.totalViews.toLocaleString();
                const finalText = `${formattedViews} visits`;

                // Super fast scramble into final text (350ms)
                scrambleText(alienText, finalText, 350);

                // Add tooltip with unique visitors
                countElement.title = `${data.uniqueViews.toLocaleString()} unique · ${data.todayUnique} today`;

                // Remove loading class
                countElement.classList.remove("loading");
            }
        } catch (error) {
            clearInterval(initialScramble);

            // Don't log aborted fetches (timeout)
            if (error instanceof Error && error.name !== "AbortError") {
                console.error("Visit counter error:", error);
            }

            if (alienText) {
                scrambleText(alienText, "— visits", 250);
                if (countElement) {
                    countElement.title = "Counter unavailable";
                    countElement.classList.remove("loading");
                }
            }
        }
    }

    // Use requestIdleCallback for non-blocking execution
    // Falls back to setTimeout if not supported
    const scheduleUpdate = () => {
        if ("requestIdleCallback" in window) {
            requestIdleCallback(updateVisitCount, { timeout: 2000 });
        } else {
            setTimeout(updateVisitCount, 100);
        }
    };

    // Run after page loads - non-blocking
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", scheduleUpdate);
    } else {
        scheduleUpdate();
    }
</script>

<style>
    .visit-counter {
        animation: fade-in 0.4s ease-out 0.5s both;
    }

    /* Alien loading effect */
    .loading .alien-text {
        color: #52525b;
        text-shadow: 0 0 8px rgba(82, 82, 91, 0.5);
    }

    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Mobile responsiveness */
    @media (max-width: 768px) {
        .visit-counter {
            bottom: 1rem;
            right: 1rem;
            font-size: 0.65rem;
        }

        .visit-counter > div {
            padding: 0.5rem 0.75rem;
        }
    }
</style>
