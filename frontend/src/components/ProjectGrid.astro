---
import ProjectCard from "./ProjectCard.astro";

interface Project {
  id: string;
  type: "github" | "product" | "project";
  title: string;
  description: string;
  url: string;
  technologies: string[];
  featured?: boolean;
  status?: string;
  hasCaseStudy?: boolean;
  caseStudyId?: string;
  metrics?: {
    users?: string;
    rating?: string;
    stars?: number;
  };
}

let projects: Project[] = [];
try {
  const loaded = (await import("../data/projects.json")).default as unknown;
  if (Array.isArray(loaded)) {
    projects = loaded.filter((p) => p && typeof p === "object" && p.id && p.title) as Project[];
  }
} catch (error) {
  console.warn("Could not load projects.json", error);
}
---

<section id="work" class="py-16 sm:py-24 lg:py-32 px-4 sm:px-6 lg:px-8 gpu-accelerated">
  <div class="container mx-auto max-w-6xl">
    <!-- Asymmetric section header -->
    <div class="lg:ml-12">
      <div class="mb-12 sm:mb-16 border-l-[3px] border-white pl-6 sm:pl-8 lg:pl-12 animate-fade-in">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-3">
          <h2 class="text-display text-4xl sm:text-5xl lg:text-6xl font-black text-white uppercase tracking-tighter">
            Work
          </h2>
          <p class="text-zinc-500 text-mono text-xs uppercase tracking-wider">
            {projects.length}
            {projects.length === 1 ? "Project" : "Projects"}
          </p>
        </div>

        <p class="text-zinc-400 text-sm sm:text-base max-w-2xl leading-relaxed">
          A curated selection of projects spanning full-stack development, products, and open-source contributions.
        </p>
      </div>
    </div>

    <!-- Editorial Bento Layout - breaking the algorithmic grid -->
    <div class="lg:ml-12 lg:pl-12">
      {
        projects.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-12 md:grid-cols-12 gap-5 sm:gap-6">
            {projects.map((project, index) => {
              // Create an asymmetric, curated editorial feel
              const isFirst = index === 0;
              const isFeatured = project.featured;

              let spanClass = "sm:col-span-12 md:col-span-6 lg:col-span-4"; // Default compact card
              if (isFirst && isFeatured) {
                spanClass = "sm:col-span-12 md:col-span-12 lg:col-span-8"; // Hero project
              } else if (isFeatured) {
                spanClass = "sm:col-span-12 md:col-span-12 lg:col-span-6"; // Feature project
              } else if (index % 5 === 0) {
                spanClass = "sm:col-span-12 md:col-span-6 lg:col-span-8"; // Occasional wide card for rhythm
              }

              return (
                <div class={`animate-fade-in ${spanClass}`}>
                  <ProjectCard
                    id={project.id}
                    type={project.type}
                    title={project.title}
                    description={project.description}
                    url={project.url}
                    technologies={project.technologies}
                    featured={project.featured}
                    status={project.status}
                    hasCaseStudy={project.hasCaseStudy}
                    caseStudyId={project.caseStudyId}
                    metrics={project.metrics}
                  />
                </div>
              );
            })}
          </div>
        ) : (
          <div class="border border-zinc-800 p-12 sm:p-20 text-center bg-zinc-950/50">
            <p class="text-zinc-400 mb-2 uppercase tracking-widest text-sm font-bold">No Projects Yet</p>
            <p class="text-mono text-xs text-zinc-500">
              Edit{" "}
              <code class="px-2 py-1 bg-zinc-900 border border-zinc-800 text-zinc-400">src/data/projects.json</code>
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>
