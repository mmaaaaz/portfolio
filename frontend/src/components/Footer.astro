---
const currentYear = new Date().getFullYear();
const profile = (await import("../data/profile.json")).default;
---

<footer class="bg-bg-primary mt-24 sm:mt-32 gpu-accelerated relative">
  <!-- Subtle top divider -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-px h-16 bg-linear-to-b from-transparent via-border-subtle/50 to-transparent"
  >
  </div>

  <div class="border-t border-border-subtle/40 pt-16 pb-12">
    <div class="container mx-auto px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 lg:gap-20">
          <!-- Left: Links -->
          <div>
            <h3 class="text-mono text-xs uppercase tracking-widest text-text-muted mb-6 font-bold">Connect</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-3">
              <a
                href={profile.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group border border-border-subtle/60 bg-bg-card/20 hover:border-accent-subtle hover:bg-bg-card/60 px-6 py-4 text-center text-text-secondary hover:text-text-primary transition-all duration-300 flex items-center justify-between min-h-[44px]"
              >
                <span class="text-sm font-medium">GitHub</span>
                <span
                  class="opacity-100 sm:opacity-0 group-hover:opacity-100 translate-x-0 sm:-translate-x-2 group-hover:translate-x-0 transition-all duration-300 text-xs text-accent"
                  >→</span
                >
              </a>

              <a
                href="https://linkedin.com/in/mmaaaaz"
                target="_blank"
                rel="noopener noreferrer"
                class="group border border-border-subtle/60 bg-bg-card/20 hover:border-accent-subtle hover:bg-bg-card/60 px-6 py-4 text-center text-text-secondary hover:text-text-primary transition-all duration-300 flex items-center justify-between min-h-[44px]"
              >
                <span class="text-sm font-medium">LinkedIn</span>
                <span
                  class="opacity-100 sm:opacity-0 group-hover:opacity-100 translate-x-0 sm:-translate-x-2 group-hover:translate-x-0 transition-all duration-300 text-xs text-accent"
                  >→</span
                >
              </a>

              <a
                href="/resume.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="group border border-border-subtle/60 bg-bg-card/20 hover:border-accent-subtle hover:bg-bg-card/60 px-6 py-4 text-center text-text-secondary hover:text-text-primary transition-all duration-300 flex items-center justify-between min-h-[44px]"
              >
                <span class="text-sm font-medium">Resume</span>
                <span
                  class="opacity-100 sm:opacity-0 group-hover:opacity-100 translate-x-0 sm:-translate-x-2 group-hover:translate-x-0 transition-all duration-300 text-xs text-accent"
                  >→</span
                >
              </a>

              <a
                href={`mailto:${profile.email || "contact@" + profile.website}`}
                class="group sm:col-span-2 border border-border-subtle/60 bg-bg-card/20 hover:border-accent-subtle hover:bg-bg-card/60 px-6 py-4 text-center text-text-secondary hover:text-text-primary transition-all duration-300 flex items-center justify-between min-h-[44px]"
              >
                <span class="text-sm font-bold tracking-wide">Email</span>
                <span
                  class="opacity-100 sm:opacity-0 group-hover:opacity-100 translate-x-0 sm:-translate-x-2 group-hover:translate-x-0 transition-all duration-300 text-xs text-accent"
                  >→</span
                >
              </a>
            </div>
          </div>

          <!-- Right: Info -->
          <div class="flex flex-col justify-between">
            <div>
              <p class="text-text-tertiary text-mono text-xs uppercase tracking-widest mb-3">
                © {currentYear} M. Maaz Uddin
              </p>
              <p class="text-text-secondary text-sm mb-6 leading-relaxed max-w-sm">
                Designed and built from scratch. Code is open source.
              </p>
              <a
                href="https://github.com/mmaaaaz/portfolio"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-xs text-text-tertiary hover:text-text-secondary transition-colors duration-300 font-mono tracking-widest uppercase"
              >
                <span class="border-b border-border-primary/50 pb-0.5">View Source</span>
                <span class="text-text-muted">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
