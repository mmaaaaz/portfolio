---
import profile from "../data/profile.json";
import VisitCounter from "./VisitCounter.astro";

const year = new Date().getFullYear();
const links = [
  { label: "GitHub", href: profile.githubUrl },
  { label: "LinkedIn", href: "https://linkedin.com/in/mmaaaaz" },
  { label: "Résumé", href: "/resume.pdf" },
];
---

<footer class="border-t border-rule">
  <div class="shell py-10 sm:py-12">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-[0.9375rem] font-medium text-ink">{profile.displayName}</p>
        <p class="micro micro-xs mt-2.5 text-ink-4">
          Full-stack engineer · {profile.location} · UTC+5
        </p>
        <p class="mt-7 max-w-sm text-[0.8125rem] leading-relaxed text-ink-4">
          Designed and built by hand. Astro and Tailwind on Cloudflare, with one Worker behind the
          visit counter.
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-8 gap-y-3" aria-label="Elsewhere">
        {
          links.map((link) => (
            <a
              class="link-sweep micro micro-xs text-ink-3 transition-colors hover:text-ink"
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
              data-cursor="OPEN"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col gap-4 border-t border-rule pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="micro micro-xs text-ink-4">© {year} — All rights reserved</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <VisitCounter />
        <a
          class="micro micro-xs text-ink-4 transition-colors hover:text-ink"
          href="https://github.com/mmaaaaz/portfolio"
          target="_blank"
          rel="noopener noreferrer"
          data-cursor="SOURCE"
        >
          View source ↗
        </a>
      </div>
    </div>
  </div>
</footer>
