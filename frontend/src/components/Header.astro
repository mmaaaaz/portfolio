---
const profile = (await import("../data/profile.json")).default;
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800/50 gpu-accelerated"
>
  <nav
    class="container mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-18 flex items-center justify-between"
    aria-label="Main navigation"
  >
    <!-- Logo with accent -->
    <a
      href="/"
      class="group text-zinc-50 font-black text-base sm:text-lg tracking-tighter hover:text-zinc-300 transition-colors flex items-center gap-2"
    >
      <span class="w-2 h-2 bg-zinc-50 group-hover:bg-accent group-hover:rotate-45 transition-all duration-300 shadow-[0_0_0_transparent] group-hover:shadow-[0_0_8px_var(--color-accent-subtle)]"></span>
      mz<span class="text-zinc-600">__</span>
    </a>

    <!-- Mobile: Minimal -->
    <div class="flex md:hidden gap-3">
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="border border-zinc-800 hover:border-accent-subtle px-4 py-2.5 text-[11px] font-bold text-mono uppercase tracking-widest text-zinc-400 hover:text-zinc-50 transition-all duration-300 min-w-[70px] text-center"
      >
        Resume
      </a>
      <a
        href={`mailto:${profile.email || "contact@" + profile.website}`}
        class="border border-zinc-800 hover:border-accent-subtle px-4 py-2.5 text-[11px] font-bold text-mono uppercase tracking-widest text-zinc-400 hover:text-zinc-50 transition-all duration-300 min-w-[70px] text-center"
      >
        Contact
      </a>
    </div>

    <!-- Desktop: Full nav -->
    <div class="hidden md:flex items-center gap-8 lg:gap-10">
      <a
        href="/#work"
        class="text-zinc-400 hover:text-zinc-50 transition-colors duration-300 text-mono text-xs uppercase tracking-widest relative group"
      >
        <span>Work</span>
        <span
          class="absolute -bottom-1 left-0 w-0 group-hover:w-full h-px bg-accent transition-all duration-500 ease-out-expo"
        ></span>
      </a>
      <a
        href="/#about"
        class="text-zinc-400 hover:text-zinc-50 transition-colors duration-300 text-mono text-xs uppercase tracking-widest relative group"
      >
        <span>About</span>
        <span
          class="absolute -bottom-1 left-0 w-0 group-hover:w-full h-px bg-accent transition-all duration-500 ease-out-expo"
        ></span>
      </a>
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="text-zinc-400 hover:text-zinc-50 transition-colors duration-300 text-mono text-xs uppercase tracking-widest relative group"
      >
        <span>Resume</span>
        <span
          class="absolute -bottom-1 left-0 w-0 group-hover:w-full h-px bg-accent transition-all duration-500 ease-out-expo"
        ></span>
      </a>
      <a
        href={`mailto:${profile.email || "contact@" + profile.website}`}
        class="border border-zinc-700 hover:border-accent hover:bg-accent hover:text-zinc-950 px-5 py-2.5 text-xs text-mono uppercase tracking-widest text-zinc-300 transition-all duration-300"
      >
        Contact
      </a>
    </div>
  </nav>
</header>

<!-- Spacer -->
<div class="h-16 sm:h-18"></div>
