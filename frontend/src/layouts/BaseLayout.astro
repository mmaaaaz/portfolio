---
interface Props {
  title: string;
  description?: string;
}

import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Cursor from "../components/Cursor.astro";
import "../styles/global.css";

const { title, description = "Developer portfolio" } = Astro.props;

const profile = (await import("../data/profile.json")).default;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = profile.avatarUrl;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: Astro.site?.toString(),
  alternateName: profile.displayName,
  jobTitle: "Full-stack Engineer",
  description: profile.bio,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Karachi",
    addressCountry: "Pakistan",
  },
  knowsAbout: [
    "Full-stack development",
    "Retrieval-augmented generation",
    "Cloudflare Workers",
    "Headless commerce",
    "Web performance",
  ],
  sameAs: [profile.githubUrl, "https://linkedin.com/in/mmaaaaz"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    {/* Fonts are self-hosted, so the only thing on the critical path is our own
        origin. These two are the latin subsets the first paint actually needs;
        latin-ext stays lazy behind its unicode-range. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-tight-latin.woff2"
      crossorigin
    />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/geist-mono-latin.woff2" crossorigin />

    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta
      name="keywords"
      content="full-stack engineer, AI engineer, retrieval augmented generation, React, Next.js, TypeScript, Cloudflare Workers, Shopify headless, Karachi, Pakistan"
    />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={`${profile.displayName} — Portfolio`} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Cursor />
    <Nav />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      /* Reveal on scroll — progressive enhancement only. */
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));

      if (reduced || !("IntersectionObserver" in window)) {
        targets.forEach((target) => target.classList.add("is-in"));
      } else {
        const observer = new IntersectionObserver(
          (entries, self) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-in");
              self.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.06 },
        );
        targets.forEach((target) => observer.observe(target));
      }

      /* Smooth scroll — desktop only, and never for reduced-motion users. */
      if (window.innerWidth >= 768 && !reduced) {
        import("lenis").then(({ default: Lenis }) => {
          const lenis = new Lenis({
            duration: 1.15,
            easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
            touchMultiplier: 1.6,
          });

          let frame = 0;
          const raf = (time: number) => {
            lenis.raf(time);
            frame = requestAnimationFrame(raf);
          };
          const sync = () => {
            if (document.hidden) {
              if (frame) {
                cancelAnimationFrame(frame);
                frame = 0;
              }
            } else if (!frame) {
              frame = requestAnimationFrame(raf);
            }
          };

          document.addEventListener("visibilitychange", sync);
          sync();
        });
      }
    </script>
  </body>
</html>
