---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmailLink from "../components/EmailLink.astro";
import WorkIndex from "../components/WorkIndex.astro";
import { entries } from "../data/work";
---

<BaseLayout
  title="404 — Nothing here"
  description="That address does not resolve to anything. Every page that does is listed here."
>
  <section class="section ruled pt-28 sm:pt-32" aria-labelledby="not-found-title">
    <p class="micro text-ink-4">404 — Not found</p>

    <h1 id="not-found-title" class="t-display mt-8 max-w-[20ch] text-ink">
      Nothing lives at this address.
    </h1>

    <p class="t-lead mt-7 max-w-[46ch]">
      It may have moved, or it may never have existed. Everything that does exist is below.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn--solid" href="/" data-cursor="HOME">
        Home
        <span class="btn__arrow btn__arrow--right" aria-hidden="true">→</span>
      </a>
      <EmailLink class="btn" fallback="https://linkedin.com/in/mmaaaaz">Email me</EmailLink>
    </div>

    <h2 class="micro mt-20 border-b border-rule pb-4 text-ink-3">
      <span class="text-ink-4">01</span> — Work
      <span class="ml-4 tnum text-ink-4">{entries.length} entries</span>
    </h2>

    <WorkIndex class="mt-2" />
  </section>
</BaseLayout>
