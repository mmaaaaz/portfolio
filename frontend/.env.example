# Backend API URL for visitor counter
# Replace with your deployed Cloudflare Worker URL after deployment
# Example: https://portfolio-api.YOUR_SUBDOMAIN.workers.dev
PUBLIC_API_URL=https://portfolio-api.YOUR_SUBDOMAIN.workers.dev

# Site URL (optional, defaults to https://maazu.xyz)
# Set this when deploying to a different domain
# SITE_URL=https://yourdomain.com
