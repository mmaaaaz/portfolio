---
interface Props {
  id: string;
  type: 'github' | 'product' | 'project';
  title: string;
  description: string;
  url: string;
  technologies: string[];
  featured?: boolean;
  status?: string;
  metrics?: {
    users?: string;
    rating?: string;
    stars?: number;
  };
}

const { id, type, title, description, url, technologies, featured, status, metrics } = Astro.props;
---

<a 
  href={url} 
  target="_blank" 
  rel="noopener noreferrer"
  class="group block h-full gpu-accelerated hover-lift"
>
  <article class="h-full bg-neutral-950 border border-neutral-900 hover:border-neutral-700 transition-all duration-300 p-6 sm:p-8 flex flex-col min-h-[280px] sm:min-h-[320px] relative overflow-hidden">
    <!-- Subtle hover background effect -->
    <div class="absolute inset-0 bg-gradient-to-br from-white/[0.02] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    
    <div class="relative z-10 flex flex-col h-full">
      <!-- Header with featured badge -->
      <div class="flex items-start justify-between mb-4 gap-4">
        <h3 class="text-lg sm:text-xl font-black text-white group-hover:text-neutral-100 transition-colors uppercase tracking-tight leading-tight">
          {title}
        </h3>
        
        {featured && (
          <span class="text-mono text-[9px] text-neutral-500 uppercase tracking-widest border border-neutral-800 px-2 py-1 flex-shrink-0 whitespace-nowrap">
            ★ Featured
          </span>
        )}
      </div>
      
      <!-- Description with better readability -->
      <p class="text-sm sm:text-base text-neutral-300 mb-auto line-clamp-3 leading-relaxed">
        {description}
      </p>
      
      <!-- Tech stack pills -->
      <div class="flex flex-wrap gap-2 mt-6 mb-5">
        {technologies.slice(0, 3).map((tech) => (
          <span class="text-[10px] sm:text-[11px] text-mono text-neutral-400 uppercase tracking-wider bg-black border border-neutral-800 px-3 py-1.5">
            {tech}
          </span>
        ))}
      </div>
      
      <!-- Footer with visual separator -->
      <div class="flex items-center justify-between text-[10px] sm:text-[11px] text-neutral-500 uppercase tracking-widest pt-5 border-t border-neutral-900">
        <div class="flex items-center gap-3 sm:gap-4 text-mono font-medium">
          <span class="text-neutral-600">{type}</span>
          
          {status && (
            <span class="hidden sm:inline text-neutral-700">/ {status}</span>
          )}
          
          {metrics?.users && (
            <span class="hidden sm:inline text-neutral-600">/ {metrics.users}</span>
          )}
          
          {metrics?.stars && metrics.stars > 0 && (
            <span class="text-neutral-600">★ {metrics.stars}</span>
          )}
        </div>
        
        <span class="text-mono text-white opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300">
          →
        </span>
      </div>
    </div>
  </article>
</a>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
