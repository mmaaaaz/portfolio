---
import ProjectCard from './ProjectCard.astro';

let projects = [];
try {
  projects = (await import('../data/projects.json')).default;
} catch (error) {
  console.warn('No projects found.');
}
---

<section id="work" class="py-16 sm:py-24 lg:py-32 px-4 sm:px-6 lg:px-8 gpu-accelerated">
  <div class="container mx-auto max-w-6xl">
    <!-- Asymmetric section header -->
    <div class="lg:ml-12">
      <div class="mb-12 sm:mb-16 border-l-[3px] border-white pl-6 sm:pl-8 lg:pl-12 animate-fade-in">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-3">
          <h2 class="text-display text-4xl sm:text-5xl lg:text-6xl font-black text-white uppercase tracking-tighter">
            Work
          </h2>
          <p class="text-neutral-500 text-mono text-xs uppercase tracking-wider">
            {projects.length} {projects.length === 1 ? 'Project' : 'Projects'}
          </p>
        </div>
        
        <p class="text-neutral-400 text-sm sm:text-base max-w-2xl leading-relaxed">
          A curated selection of projects spanning full-stack development, products, and open-source contributions.
        </p>
      </div>
    </div>
    
    <!-- Modern grid - no seamless borders, individual cards for depth -->
    <div class="lg:ml-12 lg:pl-12">
      {projects.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
          {projects.map((project) => (
            <div class="animate-fade-in">
              <ProjectCard
                id={project.id}
                type={project.type}
                title={project.title}
                description={project.description}
                url={project.url}
                technologies={project.technologies}
                featured={project.featured}
                status={project.status}
                metrics={project.metrics}
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="border border-neutral-800 p-12 sm:p-20 text-center bg-neutral-950">
          <p class="text-neutral-400 mb-2 uppercase tracking-wide text-sm font-bold">No Projects Yet</p>
          <p class="text-mono text-xs text-neutral-600">
            Edit <code class="px-2 py-1 bg-black border border-neutral-900 text-neutral-500">src/data/projects.json</code>
          </p>
        </div>
      )}
    </div>
  </div>
</section>
